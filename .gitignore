# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/

# Datos
data/raw/audio/*
data/raw/metadata/*
data/processed/audio/*
data/processed/manifests/*
data/external/**/*
