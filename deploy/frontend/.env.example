# URL del backend FastAPI.
# En desarrollo web, Expo usa automáticamente http://<host>:8000 si no defines esto.
# Para Expo Go en un teléfono físico, usa la IP LAN de la computadora:
# EXPO_PUBLIC_API_URL=http://192.168.1.25:8000
# Déjalo vacío en producción si el frontend y /api comparten el mismo origen.
EXPO_PUBLIC_API_URL=http://localhost:8000
