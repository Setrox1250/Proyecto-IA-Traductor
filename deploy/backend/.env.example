# Copia este archivo como `.env` y ajusta los valores para tu entorno.
# No incluyas credenciales reales en el repositorio.

# Aceptación explícita de la licencia CPML de Coqui XTTS-v2.
# No cambies este valor si no aceptas la licencia:
# https://huggingface.co/coqui/XTTS-v2
COQUI_TOS_AGREED=1

# Servidor
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Orígenes permitidos por CORS. En desarrollo incluye la URL de Expo Web.
# Para un dispositivo físico, agrega el origen LAN exacto, por ejemplo:
# CORS_ORIGINS=http://localhost:8081,http://192.168.1.25:8081
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:5173,http://127.0.0.1:5173

# Límites de entrada
MAX_UPLOAD_MB=20
MAX_AUDIO_SECONDS=120
MIN_AUDIO_SECONDS=0.5

# Resultados temporales (no se usa base de datos)
RESULT_DIR=.data/results
RESULT_TTL_SECONDS=3600
CLEANUP_INTERVAL_SECONDS=300

# Herramientas del sistema
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
FFMPEG_TIMEOUT_SECONDS=60
